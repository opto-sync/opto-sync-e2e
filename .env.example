# Postgres connection string used by the node server (Drizzle + pg).
# The docker-compose postgres service is reachable as host "postgres" from
# inside the compose network, or localhost:5433 from the host machine.
DATABASE_URL=postgresql://syncer:syncer_test@postgres:5432/syncer_test

# Supabase project base URL used by the rust-mash server (REST API, not a
# Postgres connection string), e.g. https://<PROJECT_ID>.supabase.co
SUPABASE_URL=http://localhost:8000

# Supabase anon/service API key used by the rust-mash server for the
# `apikey` and `Authorization: Bearer` headers.
SUPABASE_KEY=placeholder
